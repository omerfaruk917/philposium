{
  "name": "philposium",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "FORMS_DB", "database_name": "philposium-forms" }
  ],
  "ratelimits": [
    { "name": "FORM_RATE_LIMIT", "namespace_id": "9172027", "simple": { "limit": 20, "period": 60 } }
  ]
}
